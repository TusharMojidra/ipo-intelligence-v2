# ==============================================================================
# IPO Intelligence Terminal - Production Environment Variables Template
# ==============================================================================

# Server & Environment Mode
ENVIRONMENT=production
PORT=8000
APP_BASE_URL=https://your-production-app.onrender.com
ALLOWED_ORIGINS=https://your-production-app.onrender.com,http://localhost:8000

# Security & Authentication (Generate with: openssl rand -hex 32)
JWT_SECRET_KEY=generate_a_random_64_char_hex_secret_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (Neon PostgreSQL connection string)
DATABASE_URL=postgresql://neondb_owner:your_secure_password_here@ep-your-database-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Transactional Email (Resend API)
RESEND_API_KEY=re_your_api_key_here
SMTP_FROM_EMAIL=IPO Intelligence Terminal <onboarding@resend.dev>

# Google OAuth (Optional: Leave empty to disable Google Login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-production-app.onrender.com/api/auth/google/callback

# AI Companion Chatbot (Optional: Groq API key from console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
